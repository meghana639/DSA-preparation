//Count all Digits of a Number:
class Solution:
    def countDigit(self, n):
        if n == 0:
            return 1
        count = 0
        while(n != 0):
            n = n // 10
            count += 1
        return count
              
//leetcode : 9 (Palindrome Number):
class Solution:
    def isPalindrome(self, x: int) -> bool:
        count = 0
        original = x
        if x < 0:
            return False
        while(x>0):
            num = x % 10
            count = count * 10 + num
            x //= 10
        if count == original:
            return True  
        return False        

//leetcode: 7 (Reverse problem):
class Solution:
    def reverse(self, x: int) -> int:
        count = 0
        negative = x<0
        x=abs(x)
        while(x!=0):
            num = x%10
            count = count*10 + num
            x //= 10 
        if negative :
            count = -count
        if count < -2**31 or count > 2**31 - 1:
            return 0
        return count            

// GCD of two numbers:
class Solution:
    def GCD(self, n1, n2):
        gcd = 1
        for i in range(1,min(n1,n2)+1):
            if(n1 % i == 0 and n2 % i == 0):
                gcd = i
        return gcd   

(alternative solution):
class Solution:
    def GCD(self, n1, n2):
        result1 = []
        result2 = []
        for i in range(1,n1+1):
            if n1 % i == 0:
                result1.append(i)
        for j in range(1,n2+1):
            if n2 % i == 0:
                result2.append(j)

        gcd = 1
        for x in result1:
            if x in result2:
                gcd = x
        return gcd        

//Divisors of a number:
class Solution:
    def divisors(self, n):
        result = []
        for i in range(1,n+1):
            if n % i == 0:
                result.append(i)
        return result 

// Prime Numbers:
class Solution:
    def isPrime(self, n):
        result = []
        for i in range(1,n+1):
            if n % i == 0:
                result.append(i)
        if len(result) == 2:
            return True
        return False               

//Armstrong number:
class Solution:
    def isArmstrong(self, n):
        if n == 0:
            return True

        original = n
        total = 0
        count = 0

        # Count digits
        while n != 0:
            count += 1
            n //= 10

        # Restore n
        n = original

        # Calculate Armstrong sum
        while n != 0:
            digit = n % 10
            total += digit ** count
            n //= 10

        return total == original         


        
